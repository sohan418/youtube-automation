# Database credentials (kept secret, never commit the real .env)
DB_HOST=localhost
DB_PORT=3306
DB_USER=youtube
DB_PASSWORD=youtube
DB_NAME=youtube_studio

# Full override (optional) — if set, this takes precedence over the DB_* fields above
# DATABASE_URL=mysql+pymysql://youtube:youtube@localhost:3306/youtube_studio?charset=utf8mb4

# AI Provider (no OpenAI key required — pick any)
#   auto   = use OPENAI_API_KEY if set, else AI_PROVIDER_CLI, else mock
#   openai = OpenAI API (needs OPENAI_API_KEY)
#   ollama = local Ollama server (http://localhost:11434)
#   cli    = any CLI tool via AI_PROVIDER_CLI (gemini, claude, qwen, grok, ollama run, ...)
#   mock   = built-in sample data, no external calls
AI_PROVIDER=auto
AI_MODEL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Use a {prompt} placeholder for the user/system prompt, e.g.:
#   AI_PROVIDER_CLI=claude -p "{prompt}"
#   AI_PROVIDER_CLI=gemini -p "{prompt}"
#   AI_PROVIDER_CLI=ollama run llama3.2 "{prompt}"
AI_PROVIDER_CLI=
CLI_TIMEOUT_SECONDS=120
STORAGE_ROOT=../projects
ASSETS_ROOT=../assets
EXPORTS_ROOT=../exports
LOGS_ROOT=../logs
TEMPLATES_ROOT=../templates
FFMPEG_PATH=ffmpeg
DEFAULT_LANGUAGE=en
# Add your separately hosted frontend URL(s) here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com
